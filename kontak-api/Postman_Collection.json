{
  "info": {
    "_postman_id": "contact-api-collection",
    "name": "Contact Management REST API",
    "description": "Complete REST API for Contact Management Application using Laravel 11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/register",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "register"
              ]
            },
            "description": "Register a new user account"
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    pm.environment.set(\"user_id\", jsonData.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/login",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Login and get access token (saves token to environment variable)"
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/logout",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "logout"
              ]
            },
            "description": "Logout user and invalidate current token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contacts",
      "item": [
        {
          "name": "Get All Contacts",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/kontak",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "kontak"
              ]
            },
            "description": "Retrieve all contacts with their phone numbers"
          },
          "response": []
        },
        {
          "name": "Create Contact",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"contact_id\", jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"alamat\": \"Denpasar, Bali\",\n  \"tanggal_lahir\": \"2000-01-15\",\n  \"phones\": [\n    {\n      \"jenis\": \"HP\",\n      \"nomor_telepon\": \"08123456789\"\n    },\n    {\n      \"jenis\": \"Rumah\",\n      \"nomor_telepon\": \"02158123456\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/kontak",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "kontak"
              ]
            },
            "description": "Create a new contact with phone numbers (saves contact_id to environment)"
          },
          "response": []
        },
        {
          "name": "Get Single Contact",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/kontak/{{contact_id}}",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "kontak",
                "{{contact_id}}"
              ]
            },
            "description": "Retrieve a specific contact by ID (uses contact_id from environment)"
          },
          "response": []
        },
        {
          "name": "Update Contact",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Santoso Updated\",\n  \"alamat\": \"Jakarta, Indonesia\",\n  \"tanggal_lahir\": \"2000-01-15\",\n  \"phones\": [\n    {\n      \"jenis\": \"HP\",\n      \"nomor_telepon\": \"08987654321\"\n    },\n    {\n      \"jenis\": \"Kantor\",\n      \"nomor_telepon\": \"02170123456\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/kontak/{{contact_id}}",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "kontak",
                "{{contact_id}}"
              ]
            },
            "description": "Update an existing contact and its phone numbers"
          },
          "response": []
        },
        {
          "name": "Delete Contact",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/kontak/{{contact_id}}",
              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "8000",
              "path": [
                "api",
                "kontak",
                "{{contact_id}}"
              ]
            },
            "description": "Delete a contact (also deletes related phone numbers)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "contact_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ]
}
